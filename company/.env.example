# =============================================================================
# AI Auto Company — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env with real secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Pollinations API — get keys at https://enter.pollinations.ai
# Provide one or more comma-separated sk_ keys for failover.
# If you have only one key use: POLLINATIONS_API_KEYS=sk_xxx
# ---------------------------------------------------------------------------
POLLINATIONS_API_KEYS=sk_key1,sk_key2,sk_key3

# Base URL for Pollinations (usually no need to change)
POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# ---------------------------------------------------------------------------
# Free-model allowlist  (comma-separated Pollinations model IDs)
# Only models in this list will be used; any other model requested by a
# caller will fall back to DEFAULT_MODEL.
# ---------------------------------------------------------------------------
MODEL_ALLOWLIST=openai,openai-fast,qwen-coder,mistral,deepseek,claude-fast,nova-fast,nova,glm,minimax,kimi

# Default model when caller does not specify one
DEFAULT_MODEL=openai

# Request timeout in seconds (per Pollinations call)
REQUEST_TIMEOUT=120

# How long (seconds) to cool down a key that failed before retrying
KEY_COOLDOWN_SECONDS=120

# ---------------------------------------------------------------------------
# GitHub integration — create a token at https://github.com/settings/tokens
# Scopes needed: repo, workflow (if you want to trigger CI)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_token_here

# ---------------------------------------------------------------------------
# Server security
# Set this to any random secret to protect your API from public access.
# Leave blank to disable auth (only safe on a private/local network).
# Example:  openssl rand -hex 32
# ---------------------------------------------------------------------------
SERVER_API_KEY=

# ---------------------------------------------------------------------------
# Server address  (change PORT for Railway: Railway injects $PORT automatically)
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Max conversation turns to keep in session memory
MAX_HISTORY_TURNS=50
